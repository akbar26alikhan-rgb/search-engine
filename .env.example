# DeepSeekr Environment Configuration

# Server Port (default: 3001 when proxying through Vite dev, or 3000 in standalone production)
PORT=3001

# Gemini AI API Key (automatically injected in AI Studio, or from https://aistudio.google.com)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Brave Search API Key (optional - free tier gives 2,000 queries/month at https://brave.com/search/api/)
# If not provided, DeepSeekr uses GitHub, Wikipedia, Hacker News, and DuckDuckGo free providers.
BRAVE_SEARCH_API_KEY=""

# GitHub Personal Access Token (optional - raises rate limit from 60 to 5000 req/hr)
# https://github.com/settings/tokens
GITHUB_TOKEN=""

# Public Application URL (used for Brave custom search engine configuration & extension)
APP_URL="http://localhost:3000"
